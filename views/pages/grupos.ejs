<%- include('../partials/header') %>

<%
  const totalTimes = grupos.reduce((acc, g) => acc + (g.times ? g.times.length : 0), 0);
  const grupoTemPlacar = grupos.some(g => g.times && g.times.some(t => t.jogos > 0));
%>

<div class="container">
  <section class="dash-page-hero">
    <div class="dash-page-hero-text">
      <span class="dash-eyebrow"><span class="dash-eyebrow-dot"></span>FIFA WC 2026 · FASE DE GRUPOS</span>
      <h1 class="dash-page-title">Grupos</h1>
      <p class="dash-page-sub">12 grupos · <%= totalTimes %> seleções · classificação atualizada conforme os jogos</p>
    </div>

    <div class="dash-mini-kpis">
      <div class="dash-mini-kpi">
        <span class="dash-mini-kpi-num"><%= grupos.length %></span>
        <span class="dash-mini-kpi-label">Grupos</span>
      </div>
      <div class="dash-mini-kpi">
        <span class="dash-mini-kpi-num"><%= totalTimes %></span>
        <span class="dash-mini-kpi-label">Seleções</span>
      </div>
      <div class="dash-mini-kpi">
        <span class="dash-mini-kpi-num">2</span>
        <span class="dash-mini-kpi-label">Classificam</span>
      </div>
    </div>
  </section>

  <p class="grupos-legenda">
    <span class="grupos-legenda-chip"><span class="grupos-legenda-cor"></span> Top 2 de cada grupo se classificam</span>
    <span class="grupos-legenda-sep">·</span>
    <strong>Desempate:</strong> pontos → saldo de gols → gols marcados → confronto direto.
    <% if (grupoTemPlacar) { %><span class="grupos-legenda-sep">·</span><span class="grupos-legenda-live"><span class="pulse-dot"></span> atualiza automaticamente</span><% } %>
  </p>

  <% if (grupos.length === 0) { %>
    <div class="dash-empty">
      <div class="dash-empty-icon">📋</div>
      <p class="dash-empty-text">Dados dos grupos em breve.</p>
    </div>
  <% } else { %>
    <div class="dash-grupos-grid">
      <% grupos.forEach(grupo => { %>
        <%
          const temPlacar = grupo.times.some(t => t.jogos > 0);
          const maxPontos = Math.max(...grupo.times.map(t => t.pontos || 0), 9);
        %>
        <article class="dash-grupo">
          <header class="dash-grupo-head">
            <div class="dash-grupo-letra">Grupo <span><%= grupo.nome %></span></div>
            <span class="dash-grupo-tag">
              <%= temPlacar ? 'Em andamento' : 'Aguardando' %>
            </span>
          </header>

          <% if (temPlacar) { %>
            <div class="dash-grupo-table-wrap">
            <table class="dash-grupo-table">
              <thead>
                <tr>
                  <th class="dash-grupo-th-pos">#</th>
                  <th>Seleção</th>
                  <th title="Pontos">Pts</th>
                  <th title="Jogos">PJ</th>
                  <th title="Vitórias">V</th>
                  <th title="Empates">E</th>
                  <th title="Derrotas">D</th>
                  <th title="Gols marcados">GP</th>
                  <th title="Gols sofridos">GC</th>
                  <th title="Saldo de gols">SG</th>
                </tr>
              </thead>
              <tbody>
                <% grupo.times.forEach((t, i) => { %>
                  <tr class="<%= i < 2 ? 'dash-grupo-classifica' : '' %>">
                    <td class="dash-grupo-th-pos"><%= i + 1 %></td>
                    <td class="dash-grupo-time">
                      <% if (t.bandeira) { %>
                        <img src="<%= t.bandeira %>" alt="" class="bandeira-mini">
                      <% } %>
                      <span><%= t.nome %></span>
                    </td>
                    <td class="dash-grupo-pts">
                      <span class="dash-grupo-pts-num"><%= t.pontos %></span>
                      <div class="dash-grupo-bar" aria-hidden="true">
                        <div class="dash-grupo-bar-fill"
                             style="width: <%= Math.round((t.pontos || 0) / maxPontos * 100) %>%"></div>
                      </div>
                    </td>
                    <td><%= t.jogos %></td>
                    <td><%= t.vitorias %></td>
                    <td><%= t.empates %></td>
                    <td><%= t.derrotas %></td>
                    <td><%= t.gp %></td>
                    <td><%= t.gc %></td>
                    <td class="dash-grupo-sg"><%= t.sg > 0 ? '+' + t.sg : t.sg %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          <% } else { %>
            <ol class="dash-grupo-lista">
              <% grupo.times.forEach((t, i) => { %>
                <li class="dash-grupo-lista-item <%= i < 2 ? 'dash-grupo-lista-favorito' : '' %>">
                  <span class="dash-grupo-lista-pos"><%= i + 1 %></span>
                  <% if (t.bandeira) { %>
                    <img src="<%= t.bandeira %>" alt="" class="bandeira-mini">
                  <% } %>
                  <span class="dash-grupo-lista-nome"><%= t.nome %></span>
                </li>
              <% }) %>
            </ol>
          <% } %>

          <footer class="dash-grupo-foot">
            <span class="dash-grupo-foot-legenda">
              <span class="dash-grupo-foot-marker"></span>
              Top 2 classificam
            </span>
          </footer>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
  .grupos-legenda {
    background: var(--bg-terciario); border: 1px solid var(--borda);
    border-left: 3px solid var(--cor-sucesso); border-radius: var(--raio);
    padding: var(--espaco-3) var(--espaco-4); margin-bottom: var(--espaco-5);
    font-size: 0.82rem; line-height: 1.5; color: var(--texto-secundario);
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
  }
  .grupos-legenda strong { color: var(--texto-primario); }
  .grupos-legenda-chip { display: inline-flex; align-items: center; gap: 0.4rem; }
  .grupos-legenda-cor { width: 12px; height: 12px; border-radius: 3px; background: var(--cor-sucesso); display: inline-block; }
  .grupos-legenda-sep { opacity: 0.4; }
  .grupos-legenda-live { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--cor-ciano); font-weight: 600; }
  .dash-grupo-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .dash-grupo-sg { font-variant-numeric: tabular-nums; }
</style>

<% if (typeof grupoTemPlacar !== 'undefined' && grupoTemPlacar) { %>
<script>
  // Classificação ao vivo: recarrega periodicamente enquanto a Copa está em andamento.
  (function() {
    let segundos = 0;
    setInterval(() => {
      segundos += 1;
      // Recarrega a cada 60s, mas só com a aba visível (evita refresh em segundo plano)
      if (segundos >= 60 && document.visibilityState === 'visible') location.reload();
    }, 1000);
  })();
</script>
<% } %>
<%- include('../partials/footer') %>
