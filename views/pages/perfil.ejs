<%- include('../partials/header') %>
<div class="container container-sm">
  <div class="page-header">
    <h1 class="page-title">Meu Perfil</h1>
  </div>

  <% if (msg === 'senha_ok') { %>
    <div class="admin-alert admin-alert-ok">Senha alterada com sucesso!</div>
  <% } else if (msg === 'senha_atual_errada') { %>
    <div class="admin-alert admin-alert-erro">A senha atual está incorreta.</div>
  <% } else if (msg === 'senha_invalida') { %>
    <div class="admin-alert admin-alert-erro">A nova senha deve ter no mínimo 6 caracteres.</div>
  <% } %>

  <div class="card-perfil">
    <div class="perfil-avatar" aria-hidden="true">
      <%= usuario.nome.charAt(0).toUpperCase() %>
    </div>

    <div class="perfil-info">
      <div class="perfil-row">
        <span class="perfil-label">Nome</span>
        <span class="perfil-valor"><%= usuario.nome %></span>
      </div>
      <div class="perfil-row">
        <span class="perfil-label">E-mail</span>
        <span class="perfil-valor"><%= usuario.email %></span>
      </div>
      <div class="perfil-row">
        <span class="perfil-label">Pontuação total</span>
        <span class="perfil-pontos"><%= total_pontos %> pts</span>
      </div>
      <div class="perfil-row">
        <span class="perfil-label">Posição no ranking</span>
        <span class="perfil-valor">#<%= posicao %></span>
      </div>
    </div>
  </div>

  <div class="card-perfil mt-4" id="senha">
    <div class="perfil-info" style="margin-bottom:1rem">
      <span class="perfil-label">Trocar senha</span>
    </div>
    <form method="POST" action="/perfil/senha" class="admin-form">
      <label class="admin-label" for="senha_atual">Senha atual</label>
      <input type="password" id="senha_atual" name="senha_atual" class="campeao-select" required autocomplete="current-password">
      <label class="admin-label" for="senha_nova">Nova senha (mín. 6 caracteres)</label>
      <input type="password" id="senha_nova" name="senha_nova" class="campeao-select" minlength="6" required autocomplete="new-password">
      <button type="submit" class="btn btn-primary">Salvar nova senha</button>
    </form>
  </div>

  <div class="flex gap-4 mt-4">
    <a href="/meus-palpites" class="btn btn-primary">Meus Palpites</a>
    <a href="/ranking" class="btn btn-ghost">Ver Ranking</a>
    <a href="/logout" class="btn btn-ghost">Sair</a>
  </div>
</div>
<%- include('../partials/footer') %>
