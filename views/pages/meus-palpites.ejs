<%- include('../partials/header') %>

<div class="container">
  <section class="dash-page-hero">
    <div class="dash-page-hero-text">
      <span class="dash-eyebrow"><span class="dash-eyebrow-dot"></span>BOLÃO COPA 2026</span>
      <h1 class="dash-page-title">Meus Palpites</h1>
      <p class="dash-page-sub">Faça ou edite seus palpites <strong>antes do início</strong> de cada jogo · 5 pts placar exato · 3 pts resultado · +15 acertar o campeão</p>
    </div>
  </section>

  <div class="dash-bolao-layout">
    <!-- Sidebar com stats do usuário -->
    <aside class="dash-bolao-sidebar">
      <div class="dash-bolao-pontos-card">
        <div class="dash-card-label"><span class="pulse-dot"></span>SUA PONTUAÇÃO</div>
        <div class="dash-bolao-pontos-num"><%= stats.total_pontos %></div>
        <div class="dash-bolao-pontos-unit">pontos totais</div>
      </div>

      <div class="dash-bolao-stats">
        <div class="dash-bolao-stat dash-bolao-stat-gold">
          <span class="dash-bolao-stat-num"><%= stats.placar_exatos %></span>
          <span class="dash-bolao-stat-label">⭐ Placar Exato</span>
          <span class="dash-bolao-stat-pts">+5 pts cada</span>
        </div>
        <div class="dash-bolao-stat dash-bolao-stat-green">
          <span class="dash-bolao-stat-num"><%= stats.resultados_certos %></span>
          <span class="dash-bolao-stat-label">✅ Resultado Certo</span>
          <span class="dash-bolao-stat-pts">+3 pts cada</span>
        </div>
        <div class="dash-bolao-stat dash-bolao-stat-red">
          <span class="dash-bolao-stat-num"><%= stats.erros %></span>
          <span class="dash-bolao-stat-label">❌ Errados</span>
          <span class="dash-bolao-stat-pts">0 pts</span>
        </div>
      </div>

      <div class="dash-bolao-progress">
        <div class="dash-card-label">PROGRESSO</div>
        <ul class="dash-bolao-progress-list">
          <li>
            <span class="dash-bolao-progress-label">Total palpitado</span>
            <span class="dash-bolao-progress-val"><%= stats.total_palpites %></span>
          </li>
          <li>
            <span class="dash-bolao-progress-label">Editáveis</span>
            <span class="dash-bolao-progress-val"><%= stats.editaveis %></span>
          </li>
          <li>
            <span class="dash-bolao-progress-label">Disponíveis</span>
            <span class="dash-bolao-progress-val"><%= stats.pendentes %></span>
          </li>
        </ul>
      </div>

      <a href="/ranking" class="btn btn-outline btn-small dash-bolao-cta">🏆 Ver ranking completo</a>
    </aside>

    <!-- Conteúdo principal -->
    <div class="dash-bolao-main">
      <!-- Palpite de Campeão (bônus +15 pts) -->
      <section class="dash-section">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <span class="dash-pill" style="color: var(--cor-accent); border-color: rgba(255,215,0,.25); background: rgba(255,215,0,.08)">🏆 BÔNUS</span>
            Campeão da Copa
          </h2>
          <span class="dash-link">+<%= campeao.bonus %> pts</span>
        </div>

        <div class="campeao-card">
          <% if (campeao.campeaoReal) { %>
            <%# Copa encerrada: campeão definido %>
            <div class="campeao-resultado">
              <p class="campeao-info">Campeã da Copa: <strong><%= campeao.campeaoReal %></strong></p>
              <% if (campeao.escolha) { %>
                <% if (campeao.escolha === campeao.campeaoReal) { %>
                  <span class="pontos-badge pontos-campeao">Você acertou! +<%= campeao.bonus %> pts ⭐</span>
                <% } else { %>
                  <span class="campeao-erro">Seu palpite: <%= campeao.escolha %> · 0 pts</span>
                <% } %>
              <% } else { %>
                <span class="campeao-erro">Você não palpitou o campeão.</span>
              <% } %>
            </div>
          <% } else if (!campeao.aberto) { %>
            <%# Prazo encerrado, ainda sem campeão definido %>
            <p class="campeao-info">
              Prazo encerrado.
              <% if (campeao.escolha) { %>Seu palpite: <strong><%= campeao.escolha %></strong>. Aguardando o fim da Copa.<% } else { %>Você não registrou um palpite de campeão.<% } %>
            </p>
          <% } else { %>
            <%# Aberto para palpitar %>
            <p class="campeao-info">Escolha quem você acha que vai <strong>levantar a taça</strong>. Vale <strong>+<%= campeao.bonus %> pts</strong> e pode ser alterado até o início da Copa.</p>
            <div class="campeao-form">
              <select class="campeao-select" id="campeao-select" aria-label="Seleção campeã">
                <option value="">— Selecione uma seleção —</option>
                <% campeao.selecoes.forEach(s => { %>
                  <option value="<%= s.nome %>" <%= campeao.escolha === s.nome ? 'selected' : '' %>><%= s.nome %></option>
                <% }) %>
              </select>
              <button class="btn btn-small btn-primary" id="btn-campeao">
                <%= campeao.escolha ? 'Alterar palpite' : 'Confirmar campeão' %>
              </button>
            </div>
            <% if (campeao.escolha) { %>
              <p class="campeao-atual" id="campeao-atual">Seu palpite atual: <strong><%= campeao.escolha %></strong></p>
            <% } else { %>
              <p class="campeao-atual" id="campeao-atual" hidden></p>
            <% } %>
            <div class="palpite-feedback" id="campeao-feedback" hidden></div>
          <% } %>
        </div>
      </section>

      <% if (palpitesEditaveis && palpitesEditaveis.length > 0) { %>
      <section class="dash-section">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <span class="dash-pill" style="color: var(--cor-accent); border-color: rgba(255,215,0,.25); background: rgba(255,215,0,.08)">EDITÁVEIS</span>
            Palpites Enviados
          </h2>
          <span class="dash-link"><%= palpitesEditaveis.length %> jogo(s)</span>
        </div>
        <div class="palpites-lista" id="palpites-editaveis">
          <% palpitesEditaveis.forEach(p => { %>
            <div class="card-palpite card-palpite-editavel" data-jogo-id="<%= p.jogo.id %>">
              <div class="palpite-jogo-info">
                <span class="palpite-fase"><%= p.jogo.fase %></span>
                <span class="palpite-data-hora"><%= p.jogo.data %></span>
              </div>
              <div class="palpite-times-row">
                <span class="palpite-time"><%= p.jogo.timeCasa %></span>
                <div class="palpite-placar-grupo">
                  <input type="number" class="input-placar" name="gols_casa" min="0" max="20"
                    value="<%= p.gols_casa %>" aria-label="Gols <%= p.jogo.timeCasa %>">
                  <span class="palpite-x">×</span>
                  <input type="number" class="input-placar" name="gols_fora" min="0" max="20"
                    value="<%= p.gols_fora %>" aria-label="Gols <%= p.jogo.timeFora %>">
                </div>
                <span class="palpite-time palpite-time-fora"><%= p.jogo.timeFora %></span>
              </div>
              <div class="palpite-acoes">
                <span class="palpite-atual-label">Palpite atual: <strong><%= p.gols_casa %> × <%= p.gols_fora %></strong></span>
                <button class="btn btn-small btn-outline btn-palpitar" data-jogo-id="<%= p.jogo.id %>">
                  Salvar edição
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <section class="dash-section">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <span class="dash-pill">PALPITAR</span>
            Próximos Jogos
          </h2>
          <% if (jogos.length > 0) { %>
            <span class="dash-link"><%= jogos.length %> disponível(is)</span>
          <% } %>
        </div>
        <% if (jogos.length === 0) { %>
          <div class="dash-empty">
            <div class="dash-empty-icon">✅</div>
            <p class="dash-empty-text">Você já palpitou em todos os jogos disponíveis.</p>
          </div>
        <% } else { %>
          <div class="palpites-lista" id="palpites-lista">
            <% jogos.forEach(jogo => { %>
              <div class="card-palpite" data-jogo-id="<%= jogo.id %>">
                <div class="palpite-jogo-info">
                  <span class="palpite-fase"><%= jogo.fase %></span>
                  <span class="palpite-data-hora"><%= jogo.data %></span>
                  <% if (jogo.cidade) { %><span class="palpite-cidade"><%= jogo.cidade %></span><% } %>
                </div>
                <div class="palpite-times-row">
                  <span class="palpite-time"><%= jogo.timeCasa %></span>
                  <div class="palpite-placar-grupo">
                    <input type="number" class="input-placar" name="gols_casa" min="0" max="20"
                      placeholder="0" aria-label="Gols <%= jogo.timeCasa %>">
                    <span class="palpite-x">×</span>
                    <input type="number" class="input-placar" name="gols_fora" min="0" max="20"
                      placeholder="0" aria-label="Gols <%= jogo.timeFora %>">
                  </div>
                  <span class="palpite-time palpite-time-fora"><%= jogo.timeFora %></span>
                </div>
                <div class="palpite-acoes">
                  <button class="btn btn-small btn-primary btn-palpitar" data-jogo-id="<%= jogo.id %>">
                    Confirmar palpite
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="dash-section">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <span class="dash-pill" style="color: var(--texto-terciario); border-color: var(--borda); background: rgba(255,255,255,.04)">HISTÓRICO</span>
            Palpites Encerrados
          </h2>
          <% if (palpites.length > 0) { %>
            <span class="dash-link"><%= palpites.length %> jogo(s)</span>
          <% } %>
        </div>
        <% if (palpites.length === 0) { %>
          <div class="dash-empty">
            <div class="dash-empty-icon">📊</div>
            <p class="dash-empty-text">Seus palpites de jogos encerrados aparecerão aqui.</p>
          </div>
        <% } else { %>
          <div class="dash-historico-wrap">
            <table class="tabela-historico">
              <thead>
                <tr>
                  <th>Jogo</th>
                  <th>Seu Palpite</th>
                  <th>Resultado</th>
                  <th>Pontos</th>
                </tr>
              </thead>
              <tbody>
                <% palpites.forEach(p => { %>
                  <tr>
                    <td><%= p.timeCasa %> × <%= p.timeFora %></td>
                    <td class="td-palpite"><%= p.gols_casa %> × <%= p.gols_fora %></td>
                    <td><%= p.resultado || '—' %></td>
                    <td>
                      <% if (p.pontos === 5) { %>
                        <span class="pontos-badge pontos-5">5 pts ⭐</span>
                      <% } else if (p.pontos === 3) { %>
                        <span class="pontos-badge pontos-3">3 pts</span>
                      <% } else if (p.pontos === 0) { %>
                        <span class="pontos-badge pontos-0">0 pts</span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <!-- Regulamento completo -->
      <section class="dash-section">
        <details class="regulamento">
          <summary class="regulamento-summary">
            <span class="dash-pill">📋 REGRAS</span>
            Regulamento do Bolão
            <span class="regulamento-chevron">▾</span>
          </summary>
          <div class="regulamento-corpo">
            <h3>Sistema de pontuação</h3>
            <ul class="regulamento-lista">
              <li><strong class="reg-5">5 pontos</strong> — acertar o <strong>placar exato</strong> da partida.<br><span class="reg-ex">Ex.: palpite 2×1 e resultado 2×1.</span></li>
              <li><strong class="reg-3">3 pontos</strong> — acertar apenas o <strong>resultado</strong> (vitória, empate ou derrota), errando o placar.<br><span class="reg-ex">Ex.: palpite 3×1, resultado 2×0 · palpite 1×1, resultado 2×2.</span></li>
              <li><strong class="reg-0">0 pontos</strong> — errar o resultado, ou não registrar palpite antes do início da partida.</li>
              <li><strong class="reg-bonus">+15 pontos</strong> — bônus para quem acertar o <strong>campeão da Copa</strong>.</li>
            </ul>

            <h3>Regras gerais</h3>
            <ul class="regulamento-lista">
              <li>Os palpites devem ser enviados <strong>antes do início</strong> de cada jogo. Após o apito inicial, não são permitidas alterações.</li>
              <li>Vale apenas o resultado dos <strong>90 minutos regulamentares</strong> (mais acréscimos). Prorrogação e disputa de pênaltis são desconsideradas.</li>
              <li>O palpite de campeão pode ser alterado até o início do primeiro jogo da Copa.</li>
              <li>Ao final da Copa, vence quem somar a <strong>maior pontuação</strong>.</li>
            </ul>

            <h3>Critério de desempate</h3>
            <ol class="regulamento-lista">
              <li>Maior número de <strong>placares exatos</strong> (5 pontos).</li>
              <li>Maior número de <strong>acertos de resultado</strong> (3 pontos).</li>
              <li>Persistindo o empate, o prêmio é dividido entre os participantes empatados.</li>
            </ol>
          </div>
        </details>
      </section>
    </div>
  </div>
</div>
<script src="/js/palpites.js"></script>
<%- include('../partials/footer') %>
